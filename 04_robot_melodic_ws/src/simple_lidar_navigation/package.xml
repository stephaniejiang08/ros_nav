<?xml version="1.0"?>
<package format="2">
  <name>simple_lidar_navigation</name>
  <version>0.1.0</version>
  <description>
    Minimal, safety-gated lidar wall-turn controller and GMapping/RViz launch
    configuration for the robot Melodic workspace.
  </description>
  <maintainer email="maintainers@example.invalid">Cornerstone maintainers</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>rospy</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>tf</build_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>gmapping</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf</exec_depend>
</package>
