Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Map
        - /Laser scan used for SLAM
        - /Raw laser scan
        - /Odometry
        - /TF
      Splitter Ratio: 0.5
    Tree Height: 520
  - Class: rviz/Views
    Name: Views
    Expanded:
      - /Current View
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.7
      Class: rviz/Map
      Color Scheme: map
      Draw Behind: false
      Enabled: true
      Name: Map
      Topic: /map
      Value: true
    - Class: rviz/LaserScan
      Color: 255; 80; 80
      Enabled: true
      Name: Laser scan used for SLAM
      Queue Size: 10
      Size (m): 0.03
      Size (Pixels): 3
      Style: Points
      Topic: /scan_filtered
      Value: true
    - Class: rviz/LaserScan
      Color: 80; 180; 255
      Enabled: true
      Name: Raw laser scan
      Queue Size: 10
      Size (m): 0.02
      Size (Pixels): 2
      Style: Points
      Topic: /scan
      Value: true
    - Angle Tolerance: 0.1
      Class: rviz/Odometry
      Color: 255; 255; 80
      Enabled: true
      Keep: 100
      Name: Odometry
      Position Tolerance: 0.1
      Topic: /odom
      Value: true
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.5
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Theta std deviation: 0.261799
      Topic: /initialpose
      X std deviation: 0.5
      Y std deviation: 0.5
  Value: true
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Top Down Ortho
      Scale: 20
      Value: TopDownOrtho (rviz)
Window Geometry:
  Height: 900
  Width: 1440
  X: 80
  Y: 40
